<%# Persistent drag-and-drop affordance. The whole sources list is a dropzone
    (see index.html.erb), so this hint is shown both when the list has rows and
    in the empty states. %>
<p class="n-source-drop-hint">
  <%= inline_svg "svg/download.svg", aria_hidden: true, class: "h-4 w-4" %><%= t("nosia.sources.drop_hint") %>
</p>
