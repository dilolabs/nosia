<section>
  <div class="n-title-container md:flex md:justify-between md:items-center">
    <h2 class="n-form-title"><%= t("nosia.sources.documents.new") %></h2>
    <div class="flex gap-4">
      <%= link_to source_index_path(type: "document"), class: "n-btn-secondary" do %>
        <%= inline_svg "svg/return-up-back.svg", title: t("nosia.actions.back"), alt: t("nosia.actions.back"), class: "mx-auto w-6 h-6" %>
        <span class="sr-only"><%= t("nosia.actions.back") %></span>
      <% end %>
    </div>
  </div>
  <div class="n-form-container">
    <%= render "form", document: @document %>
  </div>
</section>
