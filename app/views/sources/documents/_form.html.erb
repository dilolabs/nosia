<%= form_with(model: [:sources, document]) do |form| %>
  <div class="n-form-field">
    <%= form.label :title, t("nosia.sources.title_label"), class: "n-label" %>
    <%= form.text_field :title, class: "n-field" %>
  </div>

  <div class="n-form-field">
    <%= form.label :file, t("nosia.sources.file_label"), class: "n-label" %>
    <%= form.file_field :file, class: "n-field" %>
  </div>

  <div class="n-form-field">
    <%= form.label :account_id, t("nosia.sources.account_label"), class: "n-label" %>
    <%= form.collection_select :account_id, Current.user.accounts, :id, :name, { prompt: true, selected: Current.account, required: true }, { class: "n-select" } %>
  </div>

  <div class="n-form-actions">
    <%= form.submit t("nosia.actions.save"), class: "n-btn-primary" %>
  </div>
<% end %>
