<%= turbo_stream.remove "sources_load_more" %>
<%= turbo_stream.append "sources_list" do %>
  <% @rows.each do |row| %>
    <%= render "sources/source", row: row, account_name: source_account.name %>
  <% end %>
  <% if @has_more %>
    <div id="sources_load_more" class="py-4 text-center">
      <%= link_to t("nosia.sources.load_more"),
            source_index_path(type: @type, status: @status, sort: @sort, q: @query, page: @page + 1, format: :turbo_stream),
            data: { turbo_stream: true }, class: "n-btn-secondary" %>
    </div>
  <% end %>
<% end %>
