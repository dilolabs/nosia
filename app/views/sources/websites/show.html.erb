<div class="n-title-container md:flex md:justify-between md:items-center">
  <h2 class="n-main-title"><%= t("nosia.sources.websites.show", id: @website.id) %></h2>
  <div class="flex gap-4">
    <%= link_to sources_websites_path, class: "n-btn-secondary" do %>
      <%= inline_svg "svg/return-up-back.svg", title: t("nosia.actions.back"), alt: t("nosia.actions.back"), class: "mx-auto w-6 h-6" %>
      <span class="sr-only"><%= t("nosia.actions.back") %></span>
    <% end %>
    <%= link_to edit_sources_website_path(@website), class: "n-btn-primary" do %>
      <%= inline_svg "svg/edit.svg", title: t("nosia.actions.edit"), alt: t("nosia.actions.edit"), class: "mx-auto w-6 h-6" %>
      <span class="sr-only"><%= t("nosia.sources.websites.edit_action") %></span>
    <% end %>
    <%= link_to sources_website_path(@website), data: { turbo_method: :delete, turbo_confirm: t("nosia.actions.confirm_delete") }, class: "n-btn-danger" do %>
      <%= inline_svg "svg/trash-bin.svg", title: t("nosia.actions.delete"), alt: t("nosia.actions.delete"), class: "text-red-600 dark:text-red-300 mx-auto w-6 h-6" %>
      <span class="sr-only"><%= t("nosia.sources.websites.delete_action") %></span>
    <% end %>
  </div>
</div>
<div class="n-form-container">
  <h2 class="n-form-title">
    <%= @website.url %>
  </h2>
  <% if @website.data.present? %>
    <div class="n-form-content"><%= sanitize @website.to_html,
          tags: ApplicationHelper::SANITIZED_MARKDOWN_TAGS,
          attributes: ApplicationHelper::SANITIZED_MARKDOWN_ATTRIBUTES %></div>
  <% else %>
    <p class="n-form-content"><%= t("nosia.sources.no_content") %></p>
  <% end %>
</div>
