<%= form_with(model: source_form_model(website)) do |form| %>
  <%= render "application/validation_errors", record: website %>
  <div class="n-form-field">
    <%= form.label :url, t("nosia.sources.url_label"), class: "n-label" %>
    <%= form.url_field :url, class: "n-field" %>
  </div>

  <div class="n-form-field">
    <%= form.label :data, t("nosia.sources.data_label"), class: "n-label" %>
    <%# website.to_html renders the body only (page_body strips the crawl's
        --- frontmatter --- block). Saving the edited body therefore writes
        body-only markdown back to data, dropping the frontmatter. That's
        intended: nothing reads the frontmatter (Website#title comes from the
        H1, to_html strips it), and a re-crawl regenerates it.
        attachments: "false" hides both toolbar upload buttons and disables
        uploads -- source editors are text-only. %>
    <%= form.lexxy_rich_text_area :data,
          value: website.to_html,
          class: "n-textarea",
          attachments: "false" %>
  </div>

  <%= render "sources/account_field", form: form %>

  <div class="n-form-actions">
    <%= form.submit t("nosia.actions.save"), class: "n-btn-primary" %>
    <%= link_to t("nosia.actions.cancel"), website.persisted? ? source_show_path(website) : source_index_path, class: "n-btn-secondary" %>
  </div>
<% end %>
