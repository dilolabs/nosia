<div class="n-title-container md:flex md:justify-between md:items-center">
  <h2 class="n-main-title"><%= t("nosia.sources.qnas.show", id: @qna.id) %></h2>
  <div class="flex gap-4">
    <%= link_to sources_qnas_path, class: "n-btn-secondary" do %>
      <%= inline_svg "svg/return-up-back.svg", title: t("nosia.actions.back"), alt: t("nosia.actions.back"), class: "mx-auto w-6 h-6" %>
      <span class="sr-only"><%= t("nosia.actions.back") %></span>
    <% end %>
    <%= link_to edit_sources_qna_path(@qna), class: "n-btn-primary" do %>
      <%= inline_svg "svg/edit.svg", title: t("nosia.actions.edit"), alt: t("nosia.actions.edit"), class: "mx-auto w-6 h-6" %>
      <span class="sr-only"><%= t("nosia.sources.qnas.edit_action") %></span>
    <% end %>
    <%= link_to sources_qna_path(@qna), data: { turbo_method: :delete, turbo_confirm: t("nosia.actions.confirm_delete") }, class: "n-btn-danger" do %>
      <%= inline_svg "svg/trash-bin.svg", title: t("nosia.actions.delete"), alt: t("nosia.actions.delete"), class: "text-red-600 dark:text-red-300 mx-auto w-6 h-6" %>
      <span class="sr-only"><%= t("nosia.sources.qnas.delete_action") %></span>
    <% end %>
  </div>
</div>
<div class="n-form-container">
  <h2 class="n-form-title">
    <%= @qna.question %>
  </h2>
  <p class="n-form-content">
    <%= @qna.answer %>
  </p>
</div>
