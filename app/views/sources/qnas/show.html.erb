<% content = capture do %>
  <% if @qna.question.present? && @qna.question.to_s != source_workspace_title(@qna) %>
    <h2 class="mb-2 font-semibold"><%= t("nosia.sources.question_label") %></h2>
    <div class="n-source-plain-content" data-source-full-question><%= @qna.question %></div>
    <h2 class="mb-2 mt-5 font-semibold"><%= t("nosia.sources.answer_label") %></h2>
  <% end %>
  <div class="n-source-plain-content" data-source-answer><%= @qna.answer %></div>
<% end %>
<%= render "sources/detail", record: @qna, content: content %>
