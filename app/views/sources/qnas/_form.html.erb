<%= form_with(model: source_form_model(qna)) do |form| %>
  <%= render "application/validation_errors", record: qna %>
  <div class="n-form-field">
    <%= form.label :question, t("nosia.sources.question_label"), class: "n-label" %>
    <%= form.text_field :question, class: "n-field" %>
  </div>

  <div class="n-form-field">
    <%= form.label :answer, t("nosia.sources.answer_label"), class: "n-label" %>
    <%# attachments: "false" hides both toolbar upload buttons (image + file)
        and disables uploads -- source editors are text-only. %>
    <%= form.lexxy_rich_text_area :answer,
          value: Commonmarker.to_html(qna.answer.to_s.encode("UTF-8")),
          class: "n-textarea",
          attachments: "false" %>
  </div>

  <%= render "sources/account_field", form: form %>

  <div class="n-form-actions">
    <%= form.submit t("nosia.actions.save"), class: "n-btn-primary" %>
    <%= link_to t("nosia.actions.cancel"), qna.persisted? ? source_show_path(qna) : source_index_path, class: "n-btn-secondary" %>
  </div>
<% end %>
