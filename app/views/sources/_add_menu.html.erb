<details class="n-source-add-menu">
  <summary class="n-workspace-button n-workspace-primary"><%= t("nosia.sources.add") %></summary>
  <ul class="n-source-add-options !list-none">
    <% { document: :upload_documents, website: :add_website, text: :paste_text, qna: :add_qna }.each do |type, label| %>
      <li>
        <%= link_to source_new_path(type), class: "n-source-add-option" do %>
          <%= source_type_icon(type.to_s) %><%= t("nosia.sources.#{label}") %>
        <% end %>
      </li>
    <% end %>
  </ul>
</details>
