<%# locals: type, status, query %>
<%# .sources-empty is hidden by CSS once a row is present (e.g. a live-prepended
    upload), so dropping onto an empty list doesn't leave this state lingering. %>
<div class="sources-empty">
  <%= render "sources/drop_hint" %>
  <% if query.present? %>
    <div class="py-16 text-center text-neutral-500"><%= t("nosia.sources.empty_query", query: query) %></div>
  <% elsif status == "failed" %>
    <div class="py-16 text-center text-neutral-500"><%= t("nosia.sources.empty_failed") %></div>
  <% elsif status == "pending" %>
    <div class="py-16 text-center text-neutral-500"><%= t("nosia.sources.empty_pending") %></div>
  <% elsif type == "all" %>
    <div class="py-16 text-center space-y-3">
      <div class="text-3xl">🗂️</div>
      <h3 class="n-card-title"><%= t("nosia.sources.first") %></h3>
      <p class="text-neutral-500"><%= t("nosia.sources.first_help") %></p>
    </div>
  <% else %>
    <div class="py-16 text-center space-y-3">
      <div class="text-3xl"><%= source_type_icon(type) %></div>
      <h3 class="n-card-title"><%= t("nosia.sources.empty.#{type}") %></h3>
      <%= link_to t("nosia.sources.add_type.#{type}"), new_polymorphic_path([:sources, type.to_sym]), class: "n-btn-primary inline-block" %>
    </div>
  <% end %>
</div>
