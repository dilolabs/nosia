<% content_for :account_tool_title, t("nosia.account_experience.sources") if @scoped_source_account %>

<div class="n-title-container md:flex md:justify-between md:items-center">
  <h2 class="n-title"><%= t("nosia.sources.texts.show", id: @text.id) %></h2>
  <div class="flex gap-4">
    <%= link_to source_index_path(type: "text"), class: "n-btn-secondary" do %>
      <%= inline_svg "svg/return-up-back.svg", title: t("nosia.actions.back"), alt: t("nosia.actions.back"), class: "mx-auto w-6 h-6" %>
      <span class="sr-only"><%= t("nosia.actions.back") %></span>
    <% end %>
    <%= link_to source_edit_path(@text), class: "n-btn-primary" do %>
      <%= inline_svg "svg/edit.svg", title: t("nosia.actions.edit"), alt: t("nosia.actions.edit"), class: "mx-auto w-6 h-6" %>
      <span class="sr-only"><%= t("nosia.sources.texts.edit_action") %></span>
    <% end %>
    <%= link_to source_show_path(@text), data: { turbo_method: :delete, turbo_confirm: t("nosia.actions.confirm_delete") }, class: "n-btn-danger" do %>
      <%= inline_svg "svg/trash-bin.svg", title: t("nosia.actions.delete"), alt: t("nosia.actions.delete"), class: "text-red-600 dark:text-red-300 mx-auto w-6 h-6" %>
      <span class="sr-only"><%= t("nosia.sources.texts.delete_action") %></span>
    <% end %>
  </div>
</div>
<div class="n-form-container">
  <p class="n-form-content">
    <%= @text.data %>
  </p>
</div>
