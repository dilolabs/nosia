<%# locals: (chat:, servers:, sessions:) %>
<div class="n-composer-tools-panel" data-controller="mcp-selection">
  <p class="n-composer-tools-heading"><%= t("nosia.chat.connected_tools") %></p>
  <% if servers.any? %>
    <% servers.each do |server| %>
      <%= render "chats/mcp_option", chat: chat, server: server, session: sessions[server.id] %>
    <% end %>
  <% else %>
    <p class="n-composer-tools-heading"><%= t("nosia.chat.no_ready_servers") %></p>
    <%= link_to t("nosia.chat.configure_server"), account_mcp_servers_path(chat.account), class: "n-composer-control" %>
  <% end %>
</div>
