<div class="n-composer-account">
  <% if chat.persisted? %>
    <span data-chat-account-readonly title="<%= chat.account.name %>"><%= t("nosia.chat.account_named", name: chat.account.name) %></span>
  <% else %>
    <%= form.label :account_id, t("nosia.chat.account") %>
    <%= form.collection_select :account_id, Current.user.accounts.order(:name), :id, :name,
      { selected: chat.account_id, prompt: t("nosia.chat.select_account") },
      { required: true, aria: { describedby: "chat-account-help" },
        data: { chat_account_target: "picker", action: "change->chat-account#change" } } %>
  <% end %>
</div>
