<div id="<%= dom_id chat %>">
  <div>
    <strong><%= t("nosia.chat.model") %></strong>
    <%= chat.model&.name || t("nosia.chat.default_model") %>
  </div>

  <div>
    <strong><%= t("nosia.chat.messages") %></strong>
    <%= chat.messages.count %>
  </div>

  <div>
    <strong><%= t("nosia.chat.created") %></strong>
    <%= l(chat.created_at, format: :short) %>
  </div>
</div>
