<%# locals: (form:, chat:, field:, skills:, generating:, stop_form_id:) %>
<% editor_id = form.field_id(field) %>
<% validation_id = "#{editor_id}_validation" %>
<% source_errors_id = "#{editor_id}_sources" %>
<div class="n-chat-composer" data-controller="composer composer-sources composer-chrome"
     data-composer-skills-value="<%= skills.to_json %>"
     data-composer-sources-messages-value="<%= t('nosia.chat.source_messages').to_json %>"
     data-composer-sources-account-id-value="<%= chat.account_id %>"
     data-composer-sources-chat-id-value="<%= chat.id if chat.persisted? %>"
     data-action="chat-account:reset@window->composer-sources#reset chat-account:reset@window->composer-chrome#reset keydown.esc->composer-chrome#escape keydown->composer-chrome#linkShortcut:capture click@document->composer-chrome#outside resize@window->composer-chrome#positionTools">
  <div class="n-composer-surface">
    <%= form.label field, t("nosia.chat.message"), class: "sr-only" %>
    <%= form.lexxy_rich_text_area field, id: editor_id,
      permitted_attachment_types: "application/pdf", toolbar: '{"upload":"file"}',
      autofocus: !generating, placeholder: t(generating ? "nosia.chat.generating" : "nosia.chat.ask"),
      disabled: generating, aria: { describedby: [source_errors_id, (validation_id if form.object.errors.any?)].compact.join(" ") },
      data: { composer_target: "editor", composer_sources_target: "editor", composer_chrome_target: "editor" },
      class: "n-composer-editor" %>
    <%= form.hidden_field :attached_website_ids, multiple: true, value: nil, data: { composer_sources_target: "websiteIds" } %>
    <%= form.hidden_field :attached_document_ids, multiple: true, value: nil, data: { composer_sources_target: "documentIds" } %>
    <div class="n-skill-menu hidden" role="listbox" aria-label="<%= t('nosia.chat.available_skills') %>" data-composer-target="menu"></div>
    <ul id="<%= source_errors_id %>" hidden role="alert" class="n-composer-errors" data-composer-sources-target="errors"></ul>
    <% if form.object.errors.any? %>
      <ul id="<%= validation_id %>" class="n-composer-errors n-composer-validation" role="alert" aria-label="<%= t('nosia.chat.message_errors') %>">
        <% form.object.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    <% end %>
    <div class="n-composer-actions">
      <%= tag.div class: "n-composer-editing-tools", role: "group", aria: { label: t("nosia.chat.editor_actions"), disabled: generating },
            inert: generating, data: { chat_account_target: "editingTools" } do %>
        <button type="button" class="n-composer-control" aria-label="<%= t('nosia.chat.attach_pdf') %>" data-action="composer-chrome#upload" <%= "disabled" if generating %>>
          <svg class="n-composer-icon" width="16" height="16" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="m8 12 6-6a3.5 3.5 0 0 1 5 5l-8 8a5 5 0 0 1-7-7l8-8M7 14l7-7"/></svg>
          <span>PDF</span>
        </button>
        <details class="n-composer-formatting" data-composer-chrome-target="formatting" data-action="toggle->composer-chrome#syncFormatting">
          <summary class="n-composer-control" aria-label="<%= t('nosia.chat.formatting') %>" title="<%= t('nosia.chat.formatting') %>" data-action="keydown.enter->composer-chrome#formattingKey keydown.space->composer-chrome#formattingKey">
            <svg class="n-composer-icon" width="16" height="16" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="19" cy="12" r="1.5"/></svg>
          </summary>
          <span class="sr-only"><%= t("nosia.chat.formatting_help") %></span>
        </details>
      <% end %>
      <%= render "chats/account", chat: chat, form: form %>
      <%= render "chats/tools", chat: chat %>
      <% if generating %>
        <%= form.button type: :submit, form: stop_form_id, class: "n-composer-send n-composer-stop",
              aria: { label: t("nosia.chat.stop") }, title: t("nosia.chat.stop") do %>
          <svg class="n-composer-icon" width="16" height="16" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="6" width="12" height="12" rx="1"/></svg>
        <% end %>
      <% else %>
        <%= form.button type: :submit, class: "n-composer-send", aria: { label: t("nosia.chat.send") }, title: t("nosia.chat.send"),
              data: { chat_account_target: "send" } do %>
          <svg class="n-composer-icon" width="16" height="16" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19V5m-6 6 6-6 6 6"/></svg>
        <% end %>
      <% end %>
    </div>
  </div>
  <div class="n-composer-meta">
    <span id="chat-account-help"><%= t("nosia.chat.account_help") %></span>
    <span class="n-composer-hints"><%= t(skills.any? ? "nosia.chat.keyboard_with_skills" : "nosia.chat.keyboard") %></span>
  </div>
  <p class="n-composer-notice"><%= t("nosia.chat.disclaimer") %></p>
</div>
