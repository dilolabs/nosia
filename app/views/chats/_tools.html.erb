<%# locals: (chat:) %>
<% servers = ready_chat_mcp_servers(chat.account) %>
<% sessions = chat.persisted? ? chat.chat_mcp_sessions.index_by(&:mcp_server_id) : {} %>
<% if chat.persisted? || servers.any? %>
  <details class="n-composer-tools" data-composer-tools data-action="toggle->composer-chrome#toolsToggled">
    <summary class="n-composer-control n-composer-tools-trigger"><%= t("nosia.chat.tools") %> <span id="mcp-selected-count" class="n-composer-count"><%= sessions.size %></span></summary>
    <%= render "chats/mcp_selector", chat: chat, servers: servers, sessions: sessions %>
  </details>
<% end %>
