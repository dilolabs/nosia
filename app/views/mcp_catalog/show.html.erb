<% content_for :head, tag.meta(name: "turbo-cache-control", content: "no-cache") %>
<div class="n-workspace n-mcp-workspace" data-mcp-workspace data-mcp-screen="catalog-setup">
  <%= render "mcp_workspace/header", title: @template[:name], current: @template[:name], catalog: true, description: catalog_entry_description(@template) %>
  <%= render "mcp_workspace/feedback" %>
  <% added = @added_servers.fetch(@template[:id], []) %>
  <% blocked = @template[:transport_type] == "stdio" && !McpServer.stdio_enabled? %>
  <% if added.any? && @mcp_server.errors.empty? %>
    <section class="n-workspace-panel">
      <h2 class="n-workspace-section-title"><%= t("nosia.mcp_workspace.added") %></h2>
      <%= link_to t(added.one? ? "nosia.mcp_workspace.manage" : "nosia.mcp_workspace.manage_many"), added.one? ? mcp_record_path(added.first) : mcp_index_path, class: "n-workspace-button" %>
    </section>
  <% elsif blocked %>
    <section class="n-workspace-panel" data-mcp-transport-unavailable data-controller="form-errors">
      <%= tag.div role: (@mcp_server.errors.any? ? 'alert' : 'status'), tabindex: -1, data: (@mcp_server.errors.any? ? { form_errors_target: 'summary' } : {}) do %>
        <p class="n-workspace-help"><%= t("nosia.mcp_workspace.stdio_unavailable") %></p>
      <% end %>
      <%= link_to t("nosia.actions.cancel"), mcp_catalog_list_path, class: "n-workspace-link" %>
    </section>
  <% else %>
    <%= form_with url: mcp_catalog_list_path, method: :post, class: "n-mcp-form-sections", data: { controller: "form-errors html-form mcp-secrets", action: "click->form-errors#focusField invalid->form-errors#revealInvalid:capture turbo:before-fetch-request->html-form#requestHTML turbo:before-cache@document->mcp-secrets#clear" } do %>
      <%= hidden_field_tag :id, @template[:id] %>
      <%= render "mcp_workspace/errors", record: @mcp_server, catalog: true %>
      <section class="n-workspace-panel space-y-4">
        <h2 class="n-workspace-section-title"><%= t("nosia.mcp.configuration") %></h2>
        <% if Array(@template[:requires_config]).any? %>
          <%= render "fields", fields: @template[:requires_config], values: @configuration_values, record: @mcp_server, catalog: true, template: @template %>
        <% else %>
          <p class="n-workspace-help"><%= t("nosia.mcp.no_config") %></p>
        <% end %>
      </section>
      <section class="n-workspace-panel">
        <h2 class="n-workspace-section-title"><%= t("nosia.mcp.capabilities") %></h2>
        <p class="n-workspace-help"><%= Array(@template[:capabilities]).map { |value| catalog_capability_label(value) }.join(" · ") %></p>
      </section>
      <div class="n-workspace-actions">
        <%= submit_tag t("nosia.mcp_workspace.add"), class: "n-workspace-button n-workspace-primary", data: { turbo_submits_with: t("nosia.mcp_workspace.adding") } %>
        <%= link_to t("nosia.actions.cancel"), mcp_catalog_list_path, class: "n-workspace-link" %>
      </div>
    <% end %>
  <% end %>
</div>
