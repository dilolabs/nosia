<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || "Nosia" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1.0">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Turbo 8 page refreshes (finish_generation! broadcast + the chat-reconnect
        staleness poll) morph the DOM instead of replacing it, so recovering a
        missed live broadcast is smooth: the live stream is preserved and scroll
        position is kept. %>
    <meta name="turbo-refresh-method" content="morph">
    <meta name="turbo-refresh-scroll" content="preserve">

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "lexxy", "data-turbo-track": "reload" %>
    <%# Lexxy engine themed to the Nosia design system (light + dark). Loaded
        after the engine stylesheet so equal-specificity :root overrides win. %>
    <%= stylesheet_link_tag "nosia/lexxy", "data-turbo-track": "reload" %>

    <%= javascript_importmap_tags %>
    <%=  render "extra_head" %>
  </head>

  <body data-controller="dark-mode" class="h-dvh flex flex-col overflow-hidden bg-neutral-100 dark:bg-neutral-900 dark:text-white">
    <% if Current.user %>
      <%= render "application/orbite_shell", page: capture { yield } %>
    <% else %>
      <div id="application-scroll" class="n-application-scroll" data-application-scroll>
        <%= render "flash" unless agent_skills_workspace_page? || mcp_workspace_page? || settings_tool_workspace_page? %>
        <%= render "application/header" %>
        <main class="n-application-page"><%= yield %></main>
      </div>
    <% end %>
  </body>
</html>
