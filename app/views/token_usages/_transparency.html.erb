<%# Transparency & methodology behind the energy estimates %>
<section class="w-full max-w-4xl mx-auto mt-4">
  <details class="group rounded-2xl bg-white dark:bg-neutral-800 shadow-sm border n-main-border">
    <summary class="flex cursor-pointer items-center gap-3 p-4 list-none n-main-hover rounded-2xl">
      <%= inline_svg "svg/question-circle.svg", title: t("nosia.usage.methodology"), alt: t("nosia.usage.methodology"), class: "w-5 h-5 text-neutral-500 dark:text-neutral-400 shrink-0" %>
      <span class="text-sm font-semibold text-neutral-700 dark:text-neutral-300"><%= t("nosia.usage.methodology_question") %></span>
      <%= inline_svg "svg/chevron-down.svg", title: t("nosia.usage.expand"), alt: t("nosia.usage.expand"), class: "w-4 h-4 ml-auto text-neutral-400 transition-transform group-open:rotate-180 shrink-0" %>
    </summary>

    <div class="px-4 pb-4 pt-1 space-y-3 text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed border-t n-main-border">
      <p>
        <%= t("nosia.usage.methodology_intro_html",
              ecologits: link_to("Ecologits", "https://ecologits.ai", target: "_blank", rel: "noopener", class: "text-blue-600 dark:text-blue-400 underline hover:text-blue-800 dark:hover:text-blue-300"),
              comparia: link_to("compar:IA", "https://comparia.beta.gouv.fr", target: "_blank", rel: "noopener", class: "text-blue-600 dark:text-blue-400 underline hover:text-blue-800 dark:hover:text-blue-300")) %>
      </p>

      <p>
        <%= t("nosia.usage.methodology_lifecycle_html") %>
      </p>

      <p>
        <%= t("nosia.usage.methodology_measurement_html") %>
      </p>

      <p class="text-neutral-500 dark:text-neutral-500 italic">
        <%= t("nosia.usage.methodology_caveat") %>
      </p>

      <div class="rounded-lg bg-neutral-50 dark:bg-neutral-900/40 border n-main-border p-3 text-xs text-neutral-500 dark:text-neutral-400">
        <p class="font-medium text-neutral-600 dark:text-neutral-300 mb-1"><%= t("nosia.usage.data_source") %></p>
        <p>
          <%= t("nosia.usage.dataset_source_html",
                dataset: link_to(t("nosia.usage.dataset_name"), "https://comparia.beta.gouv.fr/ranking", target: "_blank", rel: "noopener", class: "text-blue-600 dark:text-blue-400 underline"),
                date: l(Date.new(2026, 7, 2), format: :dataset_snapshot)) %>
        </p>
        <p class="mt-1.5">
          <%= t("nosia.usage.dataset_fallback_html") %>
        </p>
      </div>
    </div>
  </details>
</section>
