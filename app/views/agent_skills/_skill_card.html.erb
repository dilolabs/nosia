<li class="n-card n-main-border lg:col-span-2" id="<%= dom_id(skill) %>">
  <div class="m-5 p-1 truncate space-y-3">
    <div class="flex items-center justify-between gap-2">
      <span class="n-tag <%= skill.enabled? ? "n-tag-ready" : "n-tag-disconnected" %>">
        <%= t(skill.enabled? ? "nosia.skills.enabled" : "nosia.skills.disabled") %>
      </span>
      <div class="flex items-center gap-1">
        <%= button_to toggle_agent_skill_path(skill), method: :patch,
            title: t(skill.enabled? ? "nosia.skills.disable" : "nosia.skills.enable"),
            class: "n-btn-icon n-main-hover n-main-focus",
            form: { data: { turbo: false } } do %>
          <%= inline_svg "svg/power.svg", aria_hidden: true, class: "mx-auto w-5 h-5" %>
          <span class="sr-only"><%= t(skill.enabled? ? "nosia.skills.disable" : "nosia.skills.enable") %></span>
        <% end %>
        <%= link_to agent_skill_path(skill), title: t("nosia.skills.show"), class: "n-btn-icon n-main-hover n-main-focus" do %>
          <%= inline_svg "svg/eye.svg", aria_hidden: true, class: "mx-auto w-5 h-5" %>
          <span class="sr-only"><%= t("nosia.skills.show") %></span>
        <% end %>
        <%= link_to edit_agent_skill_path(skill), title: t("nosia.skills.edit"), class: "n-btn-icon n-main-hover n-main-focus" do %>
          <%= inline_svg "svg/edit.svg", aria_hidden: true, class: "mx-auto w-5 h-5" %>
          <span class="sr-only"><%= t("nosia.skills.edit") %></span>
        <% end %>
        <%= button_to agent_skill_path(skill), method: :delete,
            title: t("nosia.skills.delete"),
            class: "text-red-600 dark:text-red-300 n-btn-icon n-main-hover-danger n-main-focus-danger",
            form: { data: { turbo_confirm: t("nosia.actions.confirm_delete"), turbo: false } } do %>
          <%= inline_svg "svg/trash-bin.svg", aria_hidden: true, class: "mx-auto w-5 h-5" %>
          <span class="sr-only"><%= t("nosia.skills.delete") %></span>
        <% end %>
      </div>
    </div>

    <div>
      <h5 class="n-card-title">
        <span class="text-wrap"><%= skill.name %></span>
      </h5>
      <div class="flex flex-wrap gap-2 mt-1">
        <span class="n-tag n-tag-disconnected"><%= t("nosia.skills.execution.#{skill.execution_mode}") %></span>
        <span class="n-tag n-tag-disconnected"><%= t("nosia.skills.trigger.#{skill.trigger_mode}") %></span>
      </div>
    </div>

    <p class="n-card-subtitle text-wrap"><%= truncate(skill.description.to_s, length: 140) %></p>

    <% if skill.tags_list.present? %>
      <p class="text-sm text-neutral-500 dark:text-neutral-400 text-wrap">
        <span class="font-medium"><%= t("nosia.skills.tags") %></span> <%= skill.tags_list %>
      </p>
    <% end %>
  </div>
</li>
