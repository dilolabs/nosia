<%= form_with model: agent_skill, class: "space-y-4" do |f| %>
  <% if agent_skill.errors.any? %>
    <div class="n-tag-error rounded-lg p-4 text-sm">
      <h4 class="font-semibold mb-1"><%= t("nosia.skills.errors", count: agent_skill.errors.count) %></h4>
      <ul class="list-disc list-inside">
        <% agent_skill.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="n-form-field">
    <%= f.label :skill_content, t("nosia.skills.required_content"), class: "n-label block font-medium" %>
    <%= f.text_area :skill_content, rows: 20, class: "n-textarea font-mono", placeholder: t("nosia.skills.content_placeholder") %>
    <p class="text-sm text-neutral-500 dark:text-neutral-400 mt-1"><%= t("nosia.skills.content_help") %></p>
  </div>

  <div class="n-form-field">
    <%= f.label :execution_mode, t("nosia.skills.execution_mode"), class: "n-label block font-medium" %>
    <%= f.select :execution_mode, options_for_select(AgentSkill.execution_modes.keys.map { |mode| [ t("nosia.skills.execution.#{mode}"), mode ] }, agent_skill.execution_mode), { include_blank: false }, class: "n-select" %>
    <p class="text-sm text-neutral-500 dark:text-neutral-400 mt-1">
      <%= t("nosia.skills.execution_help_html") %>
    </p>
  </div>

  <div class="n-form-field">
    <%= f.label :trigger_mode, t("nosia.skills.trigger_mode"), class: "n-label block font-medium" %>
    <%= f.select :trigger_mode, options_for_select(AgentSkill.trigger_modes.keys.map { |mode| [ t("nosia.skills.trigger.#{mode}"), mode ] }, agent_skill.trigger_mode), { include_blank: false }, class: "n-select" %>
  </div>

  <div class="n-form-field">
    <%= f.label :priority, t("nosia.skills.priority"), class: "n-label block font-medium" %>
    <%= f.number_field :priority, in: 0..100, step: 1, class: "n-field" %>
    <p class="text-sm text-neutral-500 dark:text-neutral-400 mt-1"><%= t("nosia.skills.priority_help") %></p>
  </div>

  <div class="n-form-field flex items-center gap-2">
    <%= f.check_box :requires_rag_context, class: "w-4 h-4 rounded n-main-focus" %>
    <%= f.label :requires_rag_context, t("nosia.skills.requires_rag"), class: "n-label !mb-0" %>
    <span class="text-sm text-neutral-500 dark:text-neutral-400"><%= t("nosia.skills.rag_help") %></span>
  </div>

  <div class="n-form-field flex items-center gap-2">
    <%= f.check_box :enabled, class: "w-4 h-4 rounded n-main-focus" %>
    <%= f.label :enabled, t("nosia.skills.enabled"), class: "n-label !mb-0" %>
  </div>

  <div class="n-form-actions !justify-start gap-2 pt-2">
    <%= f.submit t(agent_skill.persisted? ? "nosia.skills.update" : "nosia.skills.create"), class: "n-btn-primary" %>
    <%= link_to t("nosia.actions.cancel"), agent_skills_path, class: "n-btn" %>
  </div>
<% end %>
