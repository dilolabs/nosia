<div class="n-title-container flex justify-between items-center">
  <h2 class="n-main-title"><%= t("nosia.skills.title") %></h2>
  <%= link_to new_agent_skill_path, class: "n-btn-primary inline-flex items-center gap-2" do %>
    <%= inline_svg "svg/plus.svg", aria_hidden: true, class: "w-5 h-5" %>
    <span><%= t("nosia.skills.create") %></span>
  <% end %>
</div>

<% if @agent_skills.any? %>
  <ul class="n-cards-grid !list-none">
    <% @agent_skills.each do |skill| %>
      <%= render "skill_card", skill: skill %>
    <% end %>
  </ul>
<% else %>
  <div class="n-card n-main-border my-4 lg:col-span-2">
    <div class="m-6 flex flex-col items-center text-center gap-3 py-8">
      <%= inline_svg "svg/code-bracket.svg", aria_hidden: true, class: "w-12 h-12 text-neutral-400" %>
      <p class="n-card-title text-wrap"><%= t("nosia.skills.none") %></p>
      <p class="n-card-subtitle text-wrap"><%= t("nosia.skills.none_help") %></p>
      <%= link_to t("nosia.skills.create"), new_agent_skill_path, class: "n-btn-primary mt-2" %>
    </div>
  </div>
<% end %>
