<% content_for :title, @model.name %>

<h1><%= @model.name %></h1>

<p><strong>ID:</strong> <%= @model.id %></p>
<p><strong>Provider:</strong> <%= @model.provider %></p>
<p><strong>Context Window:</strong> <%= number_with_delimiter(@model.context_window) %> tokens</p>
<p><strong>Max Output:</strong> <%= number_with_delimiter(@model.max_output_tokens) %> tokens</p>

<% input = @model.price(:input) %>
<% output = @model.price(:output) %>
<p><strong>$/1M tokens (In/Out):</strong> <%= input.nil? ? "—" : format("$%.2f", input) %> / <%= output.nil? ? "—" : format("$%.2f", output) %></p>
<% mwh = GreenIt.dataset_mwh_per_1000_tokens(@model.id) %>
<p><strong>Conso. moyenne (1000 tokens):</strong> <%= mwh ? number_with_delimiter(mwh.to_i) : "—" %></p>

<% if @model.capabilities.any? %>
  <p><strong>Capabilities:</strong> <%= @model.capabilities.join(", ") %></p>
<% end %>

<p>
  <%= link_to "Start chat with this model", new_chat_path(model: @model.id) %> |
  <%= link_to "All models", models_path %>
</p>
