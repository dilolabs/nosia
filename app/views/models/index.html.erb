<p style="color: green"><%= notice %></p>

<% content_for :title, t("nosia.models.title") %>

<h1><%= t("nosia.models.title") %></h1>

<p>
  <%= button_to t("nosia.models.refresh"), refresh_models_path, method: :post %>
</p>

<div id="models">
  <table>
    <thead>
      <tr>
        <th><%= t("nosia.models.provider") %></th>
        <th><%= t("nosia.models.model") %></th>
        <th><%= t("nosia.models.context") %></th>
        <th><%= t("nosia.models.price") %></th>
        <th><%= t("nosia.models.consumption") %></th>
        <th colspan="2"></th>
      </tr>
    </thead>
    <tbody>
      <%= render partial: "models/model", collection: @models, as: :model %>
    </tbody>
  </table>
</div>
