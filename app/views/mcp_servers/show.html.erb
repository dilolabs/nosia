<% connection_failure_alert = flash[:alert] == t("nosia.mcp.connection_failed") %>
<div class="n-workspace n-mcp-workspace" data-mcp-workspace data-mcp-screen="detail" data-controller="mcp-server mcp-busy" data-action="turbo:submit-start->mcp-busy#start turbo:submit-end->mcp-busy#finish hashchange@window->mcp-server#restore popstate@window->mcp-server#restore turbo:render@document->mcp-server#connect">
  <%= render "mcp_workspace/header", title: @mcp_server.name, current: @mcp_server.name, actions: render("connection_controls", server: @mcp_server) %>
  <%= render "mcp_workspace/feedback", suppress_alert: connection_failure_alert %>

  <div class="n-workspace-actions">
    <%= render "status", server: @mcp_server %>
    <p class="n-workspace-help"><%= t(@mcp_server.enabled? ? "nosia.mcp_workspace.enabled" : "nosia.mcp_workspace.disabled") %></p>
  </div>

  <% if flash[:connection_test].present? %>
    <%= render "connection_test_result", server: @mcp_server, success: flash[:connection_test] == "success" %>
  <% elsif connection_failure_alert || (@mcp_server.last_error.present? && flash[:alert].blank?) %>
    <%= render "connection_test_result", server: @mcp_server, success: false %>
  <% end %>

  <nav class="n-mcp-tabs" aria-label="<%= t('nosia.mcp.capabilities') %>" data-mcp-server-target="list" data-action="focusout->mcp-server#resetRoving">
    <% %i[overview tools prompts resources].each do |kind| %>
      <%= link_to "##{kind}", id: "mcp-tab-#{kind}", class: "n-workspace-link", data: { mcp_server_target: "tab", tab_key: kind, action: "click->mcp-server#select keydown->mcp-server#key" } do %>
        <%= t("nosia.mcp.#{kind}") %><% unless kind == :overview %> · <%= mcp_capability_count(@capabilities.fetch(kind)) %><% end %>
      <% end %>
    <% end %>
  </nav>

  <section id="overview" class="n-mcp-panel" data-mcp-server-target="panel" data-tab-key="overview">
    <h2 class="n-workspace-section-title"><%= t("nosia.mcp.overview") %></h2>
    <div class="n-mcp-grid">
      <section class="n-workspace-panel">
        <h3 class="n-workspace-section-title"><%= t("nosia.mcp.configuration") %></h3>
        <dl>
          <dt class="n-mcp-label"><%= t("nosia.mcp.transport_type") %></dt>
          <dd><%= t("nosia.mcp.transport.#{@mcp_server.transport_type}_short") %></dd>
          <dt class="n-mcp-label"><%= t("nosia.mcp.endpoint") %></dt>
          <dd><%= mcp_endpoint_label(@mcp_server) %></dd>
          <% if @mcp_server.tags.present? %>
            <dt class="n-mcp-label"><%= t("nosia.mcp.tags") %></dt>
            <dd><%= @mcp_server.tags %></dd>
          <% end %>
        </dl>
      </section>
      <section class="n-workspace-panel">
        <h3 class="n-workspace-section-title"><%= t("nosia.mcp_workspace.connection") %></h3>
        <p class="n-workspace-help"><%= t("nosia.mcp_workspace.historical") %></p>
        <% if @mcp_server.last_connected_at %>
          <p class="n-workspace-help"><%= t("nosia.mcp.last_connected") %>: <%= l(@mcp_server.last_connected_at, format: :short) %></p>
        <% end %>
        <% if @mcp_server.latency_ms %>
          <p class="n-workspace-help"><%= t("nosia.mcp_workspace.latest_latency", latency: t("nosia.mcp.latency", milliseconds: number_with_delimiter(@mcp_server.latency_ms))) %></p>
        <% end %>
      </section>
    </div>
    <% if @mcp_server.notes.present? %>
      <section class="n-workspace-panel">
        <h3 class="n-workspace-section-title"><%= t("nosia.mcp.notes") %></h3>
        <p class="n-workspace-help whitespace-pre-wrap"><%= @mcp_server.notes %></p>
      </section>
    <% end %>
  </section>

  <% %i[tools prompts resources].each do |kind| %>
    <%= render "capabilities", kind: kind, result: @capabilities.fetch(kind) %>
  <% end %>

  <section class="n-mcp-danger" data-mcp-danger>
    <div>
      <h2 class="n-workspace-section-title"><%= t("nosia.mcp_workspace.delete_title") %></h2>
      <p class="n-workspace-help"><%= t("nosia.mcp_workspace.delete_help") %></p>
    </div>
    <%= button_to t("nosia.actions.delete"), mcp_record_path(@mcp_server), method: :delete, class: "n-workspace-button n-workspace-danger", data: { turbo_confirm: mcp_delete_confirmation(@mcp_server) } %>
  </section>
</div>
