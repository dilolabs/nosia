<%= form_with(model: mcp_server, data: { controller: "mcp-form" }) do |form| %>
  <% if mcp_server.errors.any? %>
    <div class="rounded-lg bg-red-50 dark:bg-red-900/10 p-4">
      <h3 class="text-sm font-medium text-red-800 dark:text-red-400 mb-2">
        <%= t("nosia.mcp.errors", count: mcp_server.errors.count) %>
      </h3>
      <ul class="list-disc list-inside text-sm text-red-700 dark:text-red-300">
        <% mcp_server.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid sm:grid-cols-2 gap-4">
    <%# Basic Information %>
    <div class="n-card content-start n-main-border p-4">
      <h3 class="text-lg font-semibold mb-2"><%= t("nosia.mcp.basic") %></h3>
      <div class="space-y-4">
        <div class="n-form-field">
          <%= form.label :name, t("nosia.mcp.name"), class: "n-label" %>
          <%= form.text_field :name, required: true, class: "n-field" %>
          <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400"><%= t("nosia.mcp.name_help") %></p>
        </div>

        <div class="n-form-field">
          <%= form.label :transport_type, t("nosia.mcp.connection_type"), class: "n-label" %>
          <%= form.select :transport_type,
            [
              [t("nosia.mcp.transport.streamable"), "streamable"],
              [t("nosia.mcp.transport.sse"), "sse"],
              [t("nosia.mcp.transport.stdio"), "stdio"]
            ],
            {},
            {
              required: true,
              data: { action: "change->mcp-form#toggleTransportFields" },
              class: "n-select"
            } %>
        </div>

        <div class="n-form-field" data-mcp-form-target="httpFields">
          <%= form.label :endpoint, t("nosia.mcp.url"), class: "n-label" %>
          <%= form.text_field :endpoint, placeholder: "https://your-mcp-server.com/mcp", class: "n-field" %>
        </div>

        <div data-mcp-form-target="stdioFields" class="hidden space-y-4">
          <div class="n-form-field">
            <%= form.label :command, t("nosia.mcp.command"), class: "n-label" %>
            <%= form.text_field :command, placeholder: t("nosia.mcp.command_hint"), class: "n-field" %>
          </div>

          <div class="n-form-field">
            <%= form.label :args, t("nosia.mcp.arguments"), class: "n-label" %>
            <%= form.text_area :args, rows: 3, placeholder: "@modelcontextprotocol/server-filesystem
/path/to/directory", class: "n-textarea" %>
          </div>
        </div>

        <div class="n-form-field flex items-center gap-2">
          <%= form.check_box :enabled, class: "rounded border-neutral-300 dark:border-neutral-700 text-green-600 focus:ring-green-500" %>
          <%= form.label :enabled, t("nosia.mcp.enabled"), class: "n-label mb-0" %>
        </div>
      </div>
    </div>

    <%# Authentication %>
    <div class="n-card content-start n-main-border p-4">
      <h3 class="text-lg font-semibold mb-2"><%= t("nosia.mcp.authentication") %></h3>
      <div class="space-y-4">
        <div class="n-form-field">
          <%= form.label :token, t("nosia.mcp.bearer_token"), class: "n-label" %>
          <%= form.password_field :token, placeholder: "your-bearer-token", autocomplete: "off", class: "n-field" %>
          <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400"><%= t("nosia.mcp.bearer_help") %></p>
        </div>

        <div class="n-form-field">
          <%= form.label :api_key, t("nosia.mcp.api_key"), class: "n-label" %>
          <%= form.password_field :api_key, placeholder: "your-api-key", autocomplete: "off", class: "n-field" %>
          <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400"><%= t("nosia.mcp.api_key_help") %></p>
        </div>
      </div>
    </div>

    <%# Notes and tags %>
    <div class="n-card content-start n-main-border p-4">
      <h3 class="text-lg font-semibold mb-2"><%= t("nosia.mcp.metadata") %></h3>

      <div class="space-y-4">
        <div class="n-form-field">
          <%= form.label :tags, t("nosia.mcp.tags_input"), class: "n-label" %>
          <%= form.text_field :tags, placeholder: t("nosia.mcp.tags_hint"), class: "n-field" %>
        </div>

        <div class="n-form-field">
          <%= form.label :notes, t("nosia.mcp.notes"), class: "n-label" %>
          <%= form.text_area :notes, rows: 4, placeholder: t("nosia.mcp.notes_hint"), class: "n-textarea" %>
        </div>
      </div>
    </div>

    <%# Actions %>
    <div class="sm:col-span-2 n-form-actions">
      <div class="flex gap-2 items-center">
        <%= form.submit t("nosia.actions.save"), class: "n-btn-primary" %>
        <%= link_to t("nosia.actions.cancel"), mcp_servers_path, class: "n-btn border n-main-border n-main-hover-tertiary n-main-focus-tertiary" %>
      </div>
    </div>
  </div>
<% end %>
