<%# locals: (mcp_server:) %>
<%= form_with model: mcp_form_model(mcp_server), class: "n-mcp-form-sections", data: { mcp_form: true, controller: "mcp-form form-errors html-form mcp-secrets", action: "click->form-errors#focusField invalid->form-errors#revealInvalid:capture turbo:before-fetch-request->html-form#requestHTML turbo:before-cache@document->mcp-secrets#clear" } do |f| %>
  <%= render "mcp_workspace/errors", record: mcp_server %>
  <section class="n-workspace-panel space-y-4">
    <h2 class="n-workspace-section-title"><%= t("nosia.mcp.configuration") %></h2>
    <%= render "mcp_workspace/field", form: f, attribute: :name, label: t("nosia.mcp.name"), required: true %>
    <% if mcp_server.local? %>
      <%= f.hidden_field :transport_type, value: "local" %>
      <p class="n-workspace-help"><%= t("nosia.mcp_workspace.local_transport_fixed") %></p>
    <% else %>
      <% choices = %w[streamable sse stdio].map { |value| [ t("nosia.mcp.transport.#{value}"), value, { disabled: value == "stdio" && !McpServer.stdio_enabled? && mcp_server.transport_type != "stdio" } ] } %>
      <%= render "mcp_workspace/field", form: f, attribute: :transport_type, label: t("nosia.mcp.connection_type"), type: :select, choices: choices, required: true %>
      <% unless McpServer.stdio_enabled? %>
        <p class="n-workspace-help"><%= t("nosia.mcp_workspace.stdio_unavailable") %></p>
      <% end %>
      <div data-mcp-form-target="httpFields">
        <%= render "mcp_workspace/field", form: f, attribute: :endpoint, label: t("nosia.mcp.url"), conditional_required: true %>
      </div>
      <div class="space-y-4" data-mcp-form-target="stdioFields">
        <%= render "mcp_workspace/field", form: f, attribute: :command, label: t("nosia.mcp.command") %>
        <%= render "mcp_workspace/field", form: f, attribute: :args, label: t("nosia.mcp.arguments"), type: :textarea, value: Array(mcp_server.args).join("\n") %>
      </div>
    <% end %>
  </section>

  <% fields = mcp_server.workspace_configuration_fields %>
  <% engine = mcp_server.metadata&.[]("engine") if mcp_server.local? %>
  <% if fields.any? %>
    <%= tag.section class: "n-workspace-panel space-y-4", data: (mcp_server.local? ? {} : { mcp_form_target: "httpFields" }) do %>
      <h2 class="n-workspace-section-title"><%= t("nosia.mcp.authentication") %></h2>
      <%= render "mcp_catalog/fields", fields: fields, values: mcp_server.workspace_public_values, record: mcp_server, catalog: false, template: (McpCatalog.find(engine) if mcp_server.local?) %>
    <% end %>
  <% elsif mcp_server.local? && !Engines::Registry[engine] %>
    <section class="n-workspace-panel"><p class="n-workspace-help"><%= t("nosia.mcp_workspace.missing_registration") %></p></section>
  <% end %>

  <section class="n-workspace-panel">
    <h2 class="n-workspace-section-title"><%= t("nosia.mcp_workspace.availability") %></h2>
    <label class="n-mcp-check"><%= f.check_box :enabled %><span><%= t("nosia.mcp_workspace.enabled") %></span></label>
  </section>
  <%= tag.details class: "n-workspace-panel", open: mcp_server.errors.include?(:tags) || mcp_server.errors.include?(:notes) do %>
    <summary><%= t("nosia.mcp_workspace.organization") %></summary>
    <div class="space-y-4">
      <%= render "mcp_workspace/field", form: f, attribute: :tags, label: t("nosia.mcp.tags_input") %>
      <%= render "mcp_workspace/field", form: f, attribute: :notes, label: t("nosia.mcp.notes"), type: :textarea %>
    </div>
  <% end %>
  <div class="n-workspace-actions">
    <%= f.submit t("nosia.actions.save"), class: "n-workspace-button n-workspace-primary", data: { turbo_submits_with: t("nosia.mcp_workspace.saving") } %>
    <%= link_to t("nosia.actions.cancel"), mcp_server.persisted? ? mcp_record_path(mcp_server) : mcp_index_path, class: "n-workspace-link" %>
  </div>
<% end %>
