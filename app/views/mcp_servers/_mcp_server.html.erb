<li class="n-card n-main-border lg:col-span-2" id="<%= dom_id(server) %>">
  <div class="m-5 p-1 truncate space-y-3">
    <div class="flex items-center justify-between gap-2">
      <%= render "status", server: server %>

      <div class="flex items-center gap-1">
        <%= link_to mcp_server_path(server), title: t("nosia.mcp.show"), class: "n-btn-icon n-main-hover n-main-focus" do %>
          <%= inline_svg_tag "svg/eye.svg", aria: { hidden: true }, class: "mx-auto w-5 h-5" %>
          <span class="sr-only"><%= t("nosia.mcp.show") %></span>
        <% end %>

        <%= link_to edit_mcp_server_path(server), title: t("nosia.mcp.edit"), class: "n-btn-icon n-main-hover n-main-focus" do %>
          <%= inline_svg_tag "svg/edit.svg", aria: { hidden: true }, class: "mx-auto w-5 h-5" %>
          <span class="sr-only"><%= t("nosia.mcp.edit") %></span>
        <% end %>

        <% if server.status_ready? %>
          <%= button_to disconnect_mcp_server_path(server), method: :post,
              title: t("nosia.mcp.disconnect_server"),
              class: "text-red-600 dark:text-red-300 n-btn-icon n-main-hover-danger n-main-focus-danger",
              form: { data: { turbo: false } } do %>
            <%= inline_svg_tag "svg/power.svg", aria: { hidden: true }, class: "mx-auto w-5 h-5" %>
            <span class="sr-only"><%= t("nosia.mcp.disconnect_server") %></span>
          <% end %>
        <% else %>
          <%= button_to connect_mcp_server_path(server), method: :post,
              title: t("nosia.mcp.connect_server"),
              class: "text-green-600 dark:text-green-400 n-btn-icon n-main-hover n-main-focus",
              form: { data: { turbo: false } } do %>
            <%= inline_svg_tag "svg/power.svg", aria: { hidden: true }, class: "mx-auto w-5 h-5" %>
            <span class="sr-only"><%= t("nosia.mcp.connect_server") %></span>
          <% end %>
        <% end %>

        <%= button_to mcp_server_path(server), method: :delete,
            data: { turbo_confirm: t("nosia.mcp.delete_confirm") },
            title: t("nosia.mcp.delete"),
            class: "text-red-600 dark:text-red-300 n-btn-icon n-main-hover-danger n-main-focus-danger" do %>
          <%= inline_svg_tag "svg/trash-bin.svg", aria: { hidden: true }, class: "mx-auto w-5 h-5" %>
          <span class="sr-only"><%= t("nosia.mcp.delete") %></span>
        <% end %>
      </div>
    </div>

    <div>
      <h5 class="n-card-title">
        <%= link_to server.name, mcp_server_path(server), class: "n-main-focus text-wrap" %>
      </h5>
      <div class="flex flex-wrap items-center gap-2 mt-1">
        <span class="n-tag n-tag-disconnected"><%= t("nosia.mcp.transport.#{server.transport_type}_short") %></span>
        <% if server.latency_ms %>
          <span class="text-sm text-neutral-500 dark:text-neutral-400"><%= t("nosia.mcp.latency", milliseconds: number_with_delimiter(server.latency_ms)) %></span>
        <% end %>
      </div>
    </div>

    <% if (server.endpoint || server.command).present? %>
      <p class="n-card-subtitle text-wrap"><%= server.endpoint || server.command %></p>
    <% end %>

    <% if server.tags.present? %>
      <p class="text-sm text-neutral-500 dark:text-neutral-400 text-wrap">
        <span class="font-medium"><%= t("nosia.mcp.tags_label") %></span> <%= server.tags %>
      </p>
    <% end %>
  </div>
</li>
