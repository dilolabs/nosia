<%# locals: (server:) %>
<li class="n-mcp-row" id="<%= dom_id(server) %>" data-mcp-row data-mcp-busy-group>
  <div class="min-w-0">
    <h2 class="n-workspace-section-title"><%= link_to server.name, mcp_record_path(server), class: "n-workspace-link" %></h2>
    <p class="n-workspace-help"><%= t("nosia.mcp.transport.#{server.transport_type}_short") %> · <%= mcp_endpoint_label(server) %></p>
    <p class="n-workspace-help"><%= t(server.enabled? ? "nosia.mcp_workspace.enabled" : "nosia.mcp_workspace.disabled") %></p>
    <% if server.tags.present? %><p class="n-workspace-help"><%= server.tags %></p><% end %>
    <% if server.latency_ms %><p class="n-workspace-help"><%= t("nosia.mcp_workspace.latest_latency", latency: t("nosia.mcp.latency", milliseconds: number_with_delimiter(server.latency_ms))) %></p><% end %>
  </div>
  <%= render "status", server: server %>
  <div class="n-workspace-actions">
    <%= link_to t("nosia.mcp_workspace.open"), mcp_record_path(server), class: "n-workspace-link" %>
    <%= link_to t("nosia.actions.edit"), mcp_edit_path(server), class: "n-workspace-link" %>
    <% if server.transport_type == "stdio" && !McpServer.stdio_enabled? %>
      <p class="n-workspace-help"><%= t("nosia.mcp_workspace.stdio_unavailable") %></p>
    <% elsif server.status_ready? %>
      <%= button_to t("nosia.mcp.disconnect"), mcp_disconnect_path(server), method: mcp_disconnect_method, class: "n-workspace-button n-mcp-operation-button", data: { turbo_submits_with: t("nosia.mcp_workspace.saving") }, form: { data: { mcp_operation: true } } %>
    <% else %>
      <%= button_to t("nosia.mcp.connect"), mcp_connect_path(server), method: :post, class: "n-workspace-button n-mcp-operation-button", data: { turbo_submits_with: t("nosia.mcp.testing_connection") }, form: { data: { mcp_operation: true } } %>
    <% end %>
  </div>
</li>
