<% content_for :navbar do %>
  <li class="flex items-center">
    <%= link_to t("nosia.nav.settings"), settings_path, class:"n-ariane n-main-focus" %>
  </li>
  <li class="flex gap-1 items-center">
    <%= inline_svg_tag "svg/chevron-right.svg", aria_hidden: true, class: "shrink-0 h-5 w-5" %>
    <%= link_to t("nosia.tokens.title"), api_tokens_path, class:"n-ariane n-main-focus" %>
  </li>
<% end %>

<div class="n-title-container">
  <h2 class="n-main-title mt-0.5"><%= t("nosia.tokens.title") %></h2>
</div>

<div class="n-cards-grid">
  <div class="n-card n-main-border w-full row-span-2 lg:col-span-2">
    <div class="n-card-content">
      <h2 class="n-card-title"><%= t("nosia.tokens.new") %></h2>
      <%= render "application/validation_errors", record: @api_token %>
      <%= render "form", api_token: @api_token %>
    </div>
  </div>

  <% if flash[:created_api_token].present? %>
    <div class="n-card n-main-border lg:col-span-2">
      <div class="mt-6 ml-6 mr-4">
        <h2 class="n-card-title"><%= t("nosia.tokens.your_new") %></h2>
        <p class="text-sm text-neutral-600 dark:text-neutral-300 mt-1"><%= t("nosia.tokens.copy_now") %></p>
      </div>
      <div data-controller="clipboard" data-clipboard-success-content-value="<%= t("nosia.tokens.copied") %>" class="mb-6 ml-6 mr-4 grid grid-cols-5 gap-2 items-center">
        <input type="text" readonly value="<%= flash[:created_api_token] %>" data-clipboard-target="source"
          class="col-span-4 w-full truncate p-2 rounded-lg bg-neutral-200 text-sm focus:outline-none focus:ring-2 focus:ring-green-500 dark:bg-neutral-700 dark:placeholder-neutral-400 dark:focus:ring-green-500">
        <button type="button" data-action="clipboard#copy" data-clipboard-target="button" class="cursor-pointer n-btn-icon n-main-hover n-main-focus w-fit">
          <%= inline_svg "svg/clipboard.svg", aria_hidden: true, class: "mx-auto w-6 h-6" %>
          <span class="sr-only"><%= t("nosia.tokens.copy") %></span>
        </button>
      </div>
    </div>
  <% end %>

  <% @api_tokens.each do |api_token| %>
    <div class="n-card n-api-token-card n-main-border lg:col-span-2">
      <div class="n-card-content min-w-0">
        <div class="flex items-start gap-4 justify-between">
          <h2 class="n-card-title"><%= api_token.name %> <span class="text-sm upercase">(<%= api_token.account.name %>)</span></h2>
          <%= button_to @account ? account_api_token_path(@account, api_token) : api_token_path(api_token), method: :delete, form_class: "shrink-0", data: { turbo_confirm: t("nosia.actions.confirm_delete") }, class: "text-red-600 dark:text-red-300 n-btn-icon n-main-hover-danger n-main-focus-danger" do %>
            <%= inline_svg "svg/trash-bin.svg", aria_hidden: true, class: "mx-auto w-6 h-6" %>
            <span class="sr-only"><%= t("nosia.tokens.delete") %></span>
          <% end %>
        </div>
        <p class="text-sm text-neutral-600 dark:text-neutral-400"><%= t("nosia.tokens.security_help") %></p>
      </div>
    </div>
  <% end %>
</div>
