<% content_for :title, t("nosia.nav.accounts") %>

<section class="n-accounts">
  <%= render "workspaces/header", title: t("nosia.nav.accounts"),
      description: t("nosia.accounts_workspace.description"),
      trail: account_workspace_trail,
      breadcrumb_label: t("nosia.account_experience.breadcrumb"),
      actions: capture {
        link_to(new_account_path, class: "n-workspace-button n-workspace-primary") do
          concat inline_svg("svg/plus.svg", aria_hidden: true, class: "h-5 w-5 shrink-0")
          concat tag.span(t("nosia.accounts.add"))
        end
      } %>

  <% if @accounts.empty? %>
    <div class="n-account-panel">
      <h2><%= t("nosia.account_experience.no_accounts") %></h2>
      <p class="n-account-help"><%= t("nosia.account_experience.accounts_help") %></p>
    </div>
  <% else %>
    <ul class="n-account-cards !list-none">
      <% @accounts.each do |account| %>
        <%= render "account", account: account, counts: @counts.fetch(account.id) %>
      <% end %>
    </ul>
  <% end %>

  <%= render "pagination", page: @page, has_more: @has_more, base_path: accounts_path %>
</section>
