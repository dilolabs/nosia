<%# locals: (page:) %>
<div id="orbite-shell" class="n-orbite-shell" role="region" tabindex="-1"
     <%= tag.attributes(aria: { label: content_for(:title).presence || "Nosia" }) %>
      data-controller="chat-dialog workspace-navigation user-menu"
      data-user-menu-chat-dialog-outlet="#orbite-shell"
     data-workspace-navigation-chat-dialog-outlet="#orbite-shell"
     data-workspace-navigation-history-value="<%= chat_workspace_page? %>"
      data-action="turbo:before-visit@document->user-menu#beforeVisit turbo:before-visit@document->chat-dialog#beforeVisit turbo:before-cache@document->user-menu#beforeCache turbo:before-cache@document->workspace-navigation#beforeCache turbo:before-cache@document->chat-dialog#beforeCache turbo:before-render@document->user-menu#beforeCache turbo:before-render@document->chat-dialog#beforeRender turbo:render@document->chat-dialog#afterRender turbo:render@document->workspace-navigation#layout turbo:before-morph-attribute@document->workspace-navigation#preserve resize@window->user-menu#layout scroll->user-menu#scrolled:capture">
  <nav class="n-orbite-rail" aria-label="<%= t('nosia.orbite.navigation') %>">
    <%= link_to root_path, class: "n-orbite-logo", aria: { label: t("nosia.nav.home_page") } do %>
      <%= image_tag "nosia-logo.png", alt: "", aria: { hidden: true } %>
    <% end %>
    <%= render "application/orbite_links", compact: true %>
    <button id="workspace-history-rail-trigger" type="button" class="n-orbite-control" aria-controls="chat-history" aria-expanded="false"
            data-workspace-navigation-target="trigger" data-action="workspace-navigation#toggle">
      <%= inline_svg "svg/menu.svg", aria_hidden: true, class: "h-5 w-5" %>
      <span class="sr-only"><%= t(chat_workspace_page? ? "nosia.orbite.expand_history" : "nosia.orbite.navigation") %></span>
    </button>
    <button id="workspace-utilities-trigger" type="button" class="n-orbite-control n-orbite-utilities-trigger" aria-controls="dropdown" aria-expanded="false" data-user-menu-target="trigger" data-action="user-menu#toggle">
      <%= inline_svg "svg/user-circle.svg", aria_hidden: true, class: "h-5 w-5" %>
      <span class="sr-only"><%= t("nosia.nav.open_user_menu") %></span>
    </button>
  </nav>
  <dialog id="chat-history" class="n-orbite-navigation" aria-labelledby="chat-history-title"
          data-workspace-navigation-target="panel" <%= 'data-history-empty' if content_for?(:orbite_history_empty) %>
          data-action="close->user-menu#panelClosed close->chat-dialog#closed close->workspace-navigation#closed">
    <h2 id="chat-history-title" class="sr-only"><%= t("nosia.orbite.navigation") %></h2>
    <div class="n-orbite-navigation-actions">
      <% if chat_workspace_page? && @chat.persisted? %>
        <%= link_to new_chat_path, class: "n-workspace-button n-workspace-primary" do %>
          <%= inline_svg "svg/chat-plus-in.svg", aria_hidden: true, class: "h-5 w-5" %>
          <%= t("nosia.chat_workspace.new_chat") %>
        <% end %>
      <% end %>
      <button id="workspace-navigation-close" type="button" class="n-orbite-control n-orbite-navigation-close"
              aria-label="<%= t('nosia.chat_workspace.close') %>" title="<%= t('nosia.chat_workspace.close') %>"
              data-chat-dialog-initial-focus data-action="workspace-navigation#close">
        <%= inline_svg "svg/close.svg", aria_hidden: true, class: "h-5 w-5" %>
      </button>
    </div>
    <div class="n-orbite-panel-content">
      <nav class="n-orbite-panel-links" aria-label="<%= t('nosia.orbite.navigation') %>">
        <%= render "application/orbite_links" %>
      </nav>
      <% if content_for?(:orbite_history) %>
        <section data-orbite-history aria-label="<%= t('nosia.chat_workspace.history_title') %>">
          <%= content_for(:orbite_history) %>
        </section>
      <% end %>
    </div>
    <div class="n-orbite-utilities" aria-label="<%= t('nosia.orbite.utilities') %>">
      <%= render "application/orbite_utilities" %>
    </div>
  </dialog>
  <div id="workspace-user-menu-home" data-user-menu-target="home"><%= render "application/orbite_user_menu" %></div>
  <%= tag.main id: chat_workspace_page? ? "application-page" : "application-scroll",
        class: "n-application-page n-orbite-main #{'n-chat-main' if chat_workspace_page?}",
        data: { application_scroll: chat_workspace_page? ? nil : true } do %>
    <%= render "flash" unless agent_skills_workspace_page? || mcp_workspace_page? %>
    <div class="n-orbite-page-trail">
      <% unless agent_skills_workspace_page? || account_workspace_header? || mcp_workspace_page? || chat_workspace_page? %>
        <% if account_page? && @account %>
          <%= render "accounts/breadcrumb", account: @account, title: content_for(:account_tool_title) %>
        <% else %>
          <%= render "navbar" %>
        <% end %>
      <% end %>
    </div>
    <% unless chat_workspace_page? && @chat.account %>
      <button id="workspace-mobile-trigger" type="button" class="n-orbite-control n-orbite-mobile-only" aria-controls="chat-history" aria-haspopup="dialog" data-workspace-navigation-target="trigger" data-action="workspace-navigation#toggle"><%= t("nosia.orbite.navigation") %></button>
    <% end %>
    <%= page %>
  <% end %>
</div>
