<% if Current.user %>
  <div class="w-full max-w-max overflow-y-auto overflow-x-hidden hidden lg:block border-r n-main-border n-main-bg p-1" data-controller="reveal" data-reveal-hidden-class="hidden">
    <button data-action="reveal#toggle" type="button" class="hidden lg:block cursor-pointer n-nav-link n-main-hover w-fit">
      <%= inline_svg "svg/menu.svg", aria_hidden: true %>
      <span class="sr-only"><%= t("nosia.nav.view_menu") %></span>
    </button>
    <div class="w-max">
      <%= link_to root_path, title: t("nosia.nav.home"), aria: { label: t("nosia.nav.home_page") }, class: "n-nav-link n-main-hover" do %>
        <%= inline_svg "svg/home.svg", aria_hidden: true, class: "w-6 h-6" %>
        <span data-reveal-target="item" class="hidden"><%= t("nosia.nav.home") %></span>
      <% end %>
      <%= link_to accounts_path, title: t("nosia.nav.accounts"), aria: { label: t("nosia.nav.accounts") }, class: "n-nav-link n-main-hover" do %>
        <%= inline_svg "svg/folders.svg", aria_hidden: true, class: "w-6 h-6" %>
        <span data-reveal-target="item" class="hidden"><%= t("nosia.nav.accounts") %></span>
      <% end %>
      <%= link_to sources_path, title: t("nosia.nav.sources"), aria: { label: t("nosia.nav.sources") }, class: "n-nav-link n-main-hover" do %>
        <%= inline_svg "svg/file-search.svg", aria_hidden: true, class: "w-6 h-6" %>
        <span data-reveal-target="item" class="hidden"><%= t("nosia.nav.sources") %></span>
      <% end %>
      <%= link_to token_usage_path, title: t("nosia.nav.token_usage"), aria: { label: t("nosia.nav.token_usage") }, class: "n-nav-link n-main-hover" do %>
        <%= inline_svg "svg/chart-bar.svg", aria_hidden: true, class: "w-6 h-6" %>
        <span data-reveal-target="item" class="hidden"><%= t("nosia.nav.token_usage") %></span>
      <% end %>
    </div>
  </div>

  <div class="lg:hidden fixed z-50 w-full h-16 max-w-sm -translate-x-1/2 n-main-bg border n-main-border rounded-full bottom-2 left-1/2">
    <div class="grid h-full max-w-lg grid-cols-6 mx-auto">
      <%= link_to root_path, title: t("nosia.nav.home"), aria: { label: t("nosia.nav.home_page") }, class: "n-nav-bottom n-main-hover rounded-s-full" do %>
        <%= inline_svg "svg/home.svg", aria_hidden: true, class: "w-6 h-6" %>
      <% end %>
      <%= link_to accounts_path, title: t("nosia.nav.accounts"), aria: { label: t("nosia.nav.accounts") }, class: "n-nav-bottom n-main-hover" do %>
        <%= inline_svg "svg/folders.svg", aria_hidden: true, class: "w-6 h-6" %>
      <% end %>
      <%= link_to agent_skills_workspace_page? ? skill_workspace_new_chat_path : new_chat_path, title: t("nosia.nav.new_chat"), aria: { label: t("nosia.nav.new_chat") }, class: "n-nav-bottom rounded-full" do %>
        <%= inline_svg "svg/chats.svg", aria_hidden: true, class: "p-2 h-14 w-14 text-black bg-neutral-100 rounded-full hover:bg-green-200 dark:hover:bg-green-700 focus:ring-4 focus:ring-neutral-300 focus:outline-none dark:focus:ring-neutral-200" %>
      <% end %>
      <%= link_to sources_path, title: t("nosia.nav.sources"), aria: { label: t("nosia.nav.sources") }, class: "n-nav-bottom n-main-hover" do %>
        <%= inline_svg "svg/file-search.svg", aria_hidden: true, class: "w-6 h-6" %>
      <% end %>
      <%= link_to settings_path, title: t("nosia.nav.settings"), aria: { label: t("nosia.nav.settings") }, class: "n-nav-bottom n-main-hover" do %>
        <%= inline_svg "svg/cog.svg", aria_hidden: true, class: "w-6 h-6" %>
      <% end %>
      <%= link_to token_usage_path, title: t("nosia.nav.token_usage"), aria: { label: t("nosia.nav.token_usage") }, class: "n-nav-bottom n-main-hover rounded-e-full" do %>
        <%= inline_svg "svg/chart-bar.svg", aria_hidden: true, class: "w-6 h-6" %>
      <% end %>
    </div>
  </div>
<% end %>
