<% content_for :navbar do %>
  <li class="flex items-center">
    <%= link_to t("nosia.nav.settings"), settings_path, class:"n-ariane n-main-focus" %>
  </li>
  <li class="flex gap-1 items-center">
    <%= inline_svg_tag "svg/chevron-right.svg", aria_hidden: true, class: "shrink-0 h-5 w-5" %>
    <%= link_to t("nosia.prompts.title"), system_prompts_path, class:"n-ariane n-main-focus" %>
  </li>
  <li class="flex gap-1 items-center">
    <%= inline_svg_tag "svg/chevron-right.svg", aria_hidden: true, class: "shrink-0 h-5 w-5" %>
    <%= link_to @system_prompt.account.name, system_prompt_path(@system_prompt), class:"n-ariane n-main-focus" %>
  </li>
  <li class="flex gap-1 items-center">
    <%= inline_svg_tag "svg/chevron-right.svg", aria_hidden: true, class: "shrink-0 h-5 w-5" %>
    <%= link_to t("nosia.actions.edit"), edit_system_prompt_path(@system_prompt), class:"n-ariane n-main-focus" %>
  </li>
<% end %>

<div class="n-title-container mt-0.5">
  <h2 class="n-main-title"><%= t("nosia.actions.edit_named", name: @system_prompt.full_name) %></h2>
</div>

<%= form_with(model: @system_prompt, url: system_prompt_path(@system_prompt), class:"max-w-4xl mx-auto") do |form| %>
  <div class="n-form-field">
    <%= form.label :content, t("nosia.prompts.label"), class: "n-label" %>
    <%= form.text_area :content, rows: 25, class: "n-textarea" %>
  </div>

  <div class="sm:col-span-2 n-form-actions">
    <div class="flex gap-2 items-center">
      <%= form.submit t("nosia.actions.save"), class: "n-btn-primary" %>
      <%= link_to t("nosia.actions.cancel"), system_prompt_path(@system_prompt), class: "n-btn border n-main-border n-main-hover-tertiary n-main-focus-tertiary" %>
    </div>
  </div>
<% end %>
