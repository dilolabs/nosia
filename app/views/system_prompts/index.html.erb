<div class="n-workspace n-settings-tool" data-settings-tool data-settings-screen="prompts">
  <%= render "settings_tools/header", title: t("nosia.prompts.title"), description: t("nosia.settings_tools.prompts_description"), trail: settings_tool_trail(resource: t("nosia.prompts.title"), path: system_prompts_path) %>
  <%= render "settings_tools/feedback" %>
  <% if @system_prompts.any? %>
    <ul class="n-settings-tool-rows !list-none" role="list">
      <% @system_prompts.each do |prompt| %>
        <li class="n-settings-tool-row" data-prompt-row>
          <div>
            <h2 class="n-workspace-section-title"><%= link_to prompt.account.name, system_prompt_path(prompt), class: "n-workspace-link" %></h2>
            <p class="n-workspace-help"><%= prompt_workspace_kind(prompt) %></p>
          </div>
          <%= link_to t("nosia.settings_tools.prompt_open"), system_prompt_path(prompt), class: "n-workspace-link" %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <section class="n-workspace-panel">
      <h2 class="n-workspace-section-title"><%= t("nosia.settings_tools.prompts_empty") %></h2>
      <p class="n-workspace-help"><%= t("nosia.settings_tools.prompts_empty_help") %></p>
      <%= link_to t("nosia.settings_tools.open_accounts"), accounts_path, class: "n-workspace-link" %>
    </section>
  <% end %>
</div>
