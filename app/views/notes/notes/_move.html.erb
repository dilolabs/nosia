<%# locals: (account:, note:, options:, folders:) %>
<%= form_with url: account_note_movement_path(account, note, **options), class: "n-notes-actions" do |form| %>
  <%= form.label :note_folder_id, t("nosia.notes.move_destination") %>
  <%= form.select :note_folder_id, notes_folder_choices(folders), selected: note.note_folder_id %>
  <%= form.submit t("nosia.notes.move"), class: "n-notes-button" %>
<% end %>
