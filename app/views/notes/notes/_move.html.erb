<%# locals: (account:, note:, options:, folders:) %>
<%= form_with url: account_note_movement_path(account, note, **options), class: "n-notes-dropdown-form" do |form| %>
  <%= form.label :note_folder_id, t("nosia.notes.move_destination") %>
  <%= form.select :note_folder_id, notes_folder_choices(folders),
                  { selected: note.note_folder_id, include_blank: t("nosia.notes.choose_move_destination") },
                  required: true, autofocus: true,
                  data: { action: "turbo:before-morph-element->notes-move#rememberDestination turbo:morph-element->notes-move#restoreDestination" } %>
  <%= form.submit t("nosia.notes.move"), class: "n-notes-button" %>
<% end %>
