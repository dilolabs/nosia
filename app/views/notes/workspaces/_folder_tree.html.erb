<%# locals: (account:, groups:, parent_id:, selected_folder:, open_ids:) %>
<% if (children = groups[parent_id]).present? %>
  <ul class="n-notes-tree">
    <% children.each do |folder| %>
      <li>
        <%= link_to notes_folder_name(folder), account_notes_workspace_path(account, folder_id: folder.id),
                    aria: { current: ("page" if folder == selected_folder) } %>
        <% if groups.key?(folder.id) %>
          <%= tag.details(open: open_ids.include?(folder.id)) do %>
            <summary aria-label="<%= t("nosia.notes.subfolders_of", name: notes_folder_name(folder)) %>"><%= t("nosia.notes.subfolders") %></summary>
            <%= render "notes/workspaces/folder_tree", account:, groups:, parent_id: folder.id, selected_folder:, open_ids: %>
          <% end %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
