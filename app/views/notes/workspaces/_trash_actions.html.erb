<%# locals: (id:, restorable:, restore_path:, purge_path:, confirmation:) %>
<div class="n-notes-actions">
  <% if restorable %>
    <%= button_to t("nosia.notes.restore"), restore_path, method: :delete, class: "n-notes-button" %>
  <% else %>
    <p class="n-notes-meta"><%= t("nosia.notes.restore_parent_first") %></p>
  <% end %>
  <% if account_owner? %>
    <%= render "notes/workspaces/destructive_action", id:, label: t("nosia.notes.purge"),
               submit_label: t("nosia.notes.confirm_purge"), path: purge_path, method: :delete, confirmation: %>
  <% end %>
</div>
