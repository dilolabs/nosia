<%# locals: (account:, note:, options:, folders:, form_title:, form_body_html:, form_revision:, seed_tag:) %>
<%= link_to t("nosia.notes.back_to_list"), account_notes_workspace_path(account, **options), class: "n-notes-button n-notes-back", data: { notes_back: true } %>
<h2 id="notes-reader-heading"><%= t(note.persisted? ? "nosia.notes.editor" : "nosia.notes.new_note") %></h2>
<% if note.persisted? %>
  <p class="n-notes-meta"><%= notes_folder_path(folders[note.note_folder_id], folders) %></p>
  <details class="n-notes-editor-actions">
    <summary><%= t("nosia.notes.note_actions") %></summary>
    <div class="n-notes-actions">
      <%= button_to t(note.pin ? "nosia.notes.unpin" : "nosia.notes.pin"), account_note_pin_path(account, note, **options),
                    method: note.pin ? :delete : :post, class: "n-notes-button" %>
      <%= button_to t("nosia.notes.trash_note"), account_note_trashing_path(account, note), class: "n-notes-button" %>
    </div>
    <%= render "notes/notes/move", account:, note:, options:, folders: %>
  </details>
<% end %>

<% action = note.persisted? ? account_note_path(account, note, **options) : account_notes_path(account, **options) %>
<%= form_with model: note, url: action, class: "n-notes-form" do |form| %>
  <%= render "notes/workspaces/errors", record: note %>
  <%= form.hidden_field :draft_key %>
  <%= form.hidden_field :expected_revision, value: form_revision || 0 %>
  <%= form.hidden_field :seed_tag, value: seed_tag if note.new_record? && seed_tag.present? && !options[:tag] %>
  <%= form.label :title, t("nosia.notes.note_title") %>
  <%= form.text_field :title, value: form_title || note.title %>
  <%= form.label :body_html, t("nosia.notes.body"), for: "notes-body" %>
  <%# Lexxy uses a form-associated element. Its HTML value is escaped in the attribute
      and comes only from Note's allowlist (also on a validation rerender). %>
  <%= form.lexxy_rich_text_area :body_html, id: "notes-body", attachments: "false",
                                value: form_body_html || note.body_html.to_s %>
  <%= form.submit t("nosia.notes.save_note"), class: "n-notes-button n-notes-primary" %>
<% end %>
