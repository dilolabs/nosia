<% content_for :title, t("nosia.notes.title") %>
<% turbo_exempts_page_from_cache %>
<section class="n-notes">
  <h1><%= t("nosia.notes.title") %></h1>
  <%= render "notes/workspaces/accounts", account: @account, memberships: Current.user.accounts.order(:name, :id) %>
  <p role="alert"><%= t("nosia.notes.#{@notes_conflict_message}") %></p>
  <% if @submitted_draft %>
    <div class="n-notes-form">
      <p><%= t("nosia.notes.copy_submitted_draft") %></p>
      <%= label_tag "notes-draft-title", t("nosia.notes.submitted_title") %>
      <%= tag.input id: "notes-draft-title", type: "text", readonly: true, value: @submitted_draft.fetch(:title) %>
      <%= label_tag "notes-draft-body", t("nosia.notes.submitted_body") %>
      <%= tag.textarea @submitted_draft.fetch(:body), id: "notes-draft-body", readonly: true, rows: 8 %>
    </div>
  <% end %>
  <div class="n-notes-actions">
    <% if @saved_note_location %>
      <%= link_to t("nosia.notes.load_saved"), @saved_note_location, class: "n-notes-button" %>
    <% end %>
    <%= link_to t("nosia.notes.back_to_notes"), account_notes_workspace_path(@account), class: "n-notes-button" %>
  </div>
</section>
