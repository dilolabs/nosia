<%# locals: (account:, memberships:, compact: false) %>
<div data-notes-accounts>
  <% if memberships.size > 1 %>
    <%= render layout: "notes/workspaces/dropdown",
          locals: { id: "notes-accounts", label: t("nosia.notes.account", name: account.name),
                    close_on_focus_leave: true, button_class: compact ? "n-workspace-button" : "n-notes-button" } do %>
      <ul role="list" aria-label="<%= t("nosia.notes.switch_account") %>">
        <% memberships.each do |membership_account| %>
          <li><%= link_to membership_account.name, account_notes_workspace_path(membership_account),
                          class: "n-notes-menu-item", aria: { current: ("true" if membership_account == account) } %></li>
        <% end %>
      </ul>
    <% end %>
  <% else %>
    <%= tag.p t("nosia.notes.account", name: account.name), class: ("n-workspace-scope" if compact) %>
  <% end %>
</div>
