<%# locals: (id:, label:, close_on_focus_leave: false, icon: nil) %>
<button type="button" popovertarget="<%= id %>" class="n-notes-button n-notes-menu-trigger<%= " n-notes-icon-button" if icon %>"
        <%= tag.attributes(aria: { label: }, title: label) if icon %>>
  <% if icon %>
    <%= inline_svg "svg/#{icon}.svg", aria_hidden: true, class: "n-notes-icon" %>
    <span class="sr-only"><%= label %></span>
  <% else %>
    <span><%= label %></span>
    <%= inline_svg "svg/chevron-down.svg", aria_hidden: true, class: "n-notes-icon" %>
  <% end %>
</button>
<div id="<%= id %>" popover="auto" class="n-notes-dropdown" data-controller="notes-dropdown"
     <%= tag.attributes(data: { action: "focusin@document->notes-dropdown#closeOnFocusLeave" }) if close_on_focus_leave %>>
  <%= yield %>
</div>
