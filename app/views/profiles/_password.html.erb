<section class="n-profile-card" aria-labelledby="password">
  <h2 id="password" class="n-card-title" tabindex="-1"><%= t("nosia.profile.password_title") %></h2>
  <p class="n-profile-help"><%= t("nosia.profile.password_description") %></p>

  <%= form_with scope: :password_change, url: profile_password_path, method: :patch,
        id: "profile-password-form", class: "mt-4", data: { controller: "credential-form" } do |form| %>
    <%= form.text_field :email, type: "hidden", id: "profile_password_email", value: user.email_in_database, autocomplete: "username" %>
    <%= render "errors", section: :password, errors: errors %>
    <%= render "field", form: form, section: :password, field: :current_password, value: nil,
          errors: errors, autocomplete: "current-password", hint: nil %>
    <%= render "field", form: form, section: :password, field: :password, value: nil,
          errors: errors, autocomplete: "new-password", hint: t("nosia.profile.password_hint") %>
    <%= render "field", form: form, section: :password, field: :password_confirmation, value: nil,
          errors: errors, autocomplete: "new-password", hint: nil %>

    <p class="n-profile-note"><%= t("nosia.profile.sessions_hint") %></p>
    <div class="n-profile-actions">
      <%= form.button t("nosia.profile.password_submit"), class: "n-profile-submit",
            data: { turbo_submits_with: t("nosia.profile.password_pending") } %>
    </div>
  <% end %>
</section>
