<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<div class="n-profile">
  <%= render "workspaces/header", title: t("nosia.profile.title"),
      description: t("nosia.profile.introduction"),
      trail: [ { label: t("nosia.nav.home"), path: user_root_path },
               { label: t("nosia.profile.title"), path: nil } ] %>

  <%= render "profiles/email", user: @user, errors: (@failed_section == :email ? @user.errors : nil) %>
  <%= render "profiles/password", user: @user, errors: (@failed_section == :password ? @user.errors : nil) %>
</div>
