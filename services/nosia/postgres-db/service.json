{
  "$schema": "https://flisk.sh/schema.service.json",
  "schemaVersion": 1,
  "appName": "postgres-db",
  "appType": "bring-your-own",
  "stack": "nosia",
  "port": 5432,
  "healthCheck": {
    "command": [
      "sh",
      "-c",
      "pg_isready -U ${POSTGRES_USER} -d ${POSTGRES_DB}"
    ],
    "interval": 2,
    "timeout": 5,
    "retries": 30
  },
  "image": "pgvector/pgvector:pg16",
  "exposeViaProxy": false,
  "env": {
    "POSTGRES_DB": "${POSTGRES_DB}",
    "POSTGRES_USER": "${POSTGRES_USER}"
  },
  "secrets": {
    "required": [
      "POSTGRES_PASSWORD"
    ]
  },
  "restart": "on-failure",
  "extraPorts": [
    {
      "port": 5432
    }
  ],
  "volumes": [
    {
      "source": "postgres-db-data",
      "target": "/var/lib/postgresql/data",
      "name": "nosia_postgres-db-data"
    }
  ]
}
